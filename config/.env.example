# Application Settings
APP_NAME=Hotel Rate Monitor
APP_ENV=development
APP_DEBUG=True
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/rates.db

# Expedia API
EXPEDIA_PARTNER_ID=your_partner_id
EXPEDIA_API_KEY=your_api_key
EXPEDIA_AFFILIATE_ID=your_affiliate_id

# Booking.com API
BOOKING_AFFILIATE_ID=your_affiliate_id
BOOKING_API_KEY=your_api_key

# Trip.com API
TRIP_API_KEY=your_api_key
TRIP_API_SECRET=your_api_secret

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=./credentials.json
SPREADSHEET_ID=your_spreadsheet_id

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@hotelratemonitor.com
ALERT_EMAIL=alerts@example.com

# Scheduling
SCHEDULE_FETCH_TIME=06:00
SCHEDULE_REPORT_TIME=18:00
SCHEDULE_ENABLED=True

# Price Alert Thresholds
PRICE_CHANGE_THRESHOLD=5
ANOMALY_DETECTION_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
